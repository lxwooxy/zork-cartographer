# Copy to .env and fill in. Without a key the map still works (rule-based parsing only).
ANTHROPIC_API_KEY=

# Optional
# ZORK_LLM_MODEL=claude-opus-5-5   # model used to read each turn
# ZORK_LLM_EFFORT=low              # low | medium | high
# ZORK_LLM=off                     # turn Claude off entirely
# ZORK_SEED=42                     # random seed (keeps replays deterministic)
