# Copy to .env and fill in what you need. Everything is optional.

# Require a password to play (recommended when the server is reachable by others)
ZORK_PASSWORD=

# Claude API key for richer parsing. Without it, rule-based parsing still maps everything.
ANTHROPIC_API_KEY=

# ZORK_LLM_MODEL=claude-opus-5-5   # model used to read each turn
# ZORK_LLM_EFFORT=low              # low | medium | high
# ZORK_LLM=off                     # turn Claude parsing off even if a key is set
# ZORK_SEED=42                     # game random seed; don't change it for an existing save
# ZORK_DATA=data/world.json        # where the map and command log are saved
# PORT=8765                        # port used by run.sh
